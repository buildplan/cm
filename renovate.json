{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>buildplan/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/",
        "/(^|/)Dockerfile\\.[^/]*$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[a-z-0-9]+?))?\\s+(?:ENV|ARG) .+?=(?<currentValue>.+)"
      ]
    }
  ]
}
